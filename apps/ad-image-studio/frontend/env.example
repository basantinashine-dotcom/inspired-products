# Copy this file to frontend/.env.local and fill in both values from your
# Supabase project: Project Settings > API (or the Connect button).
#
# Both are safe to ship to the browser. The key only says which project to
# talk to; the database's row level security decides what each user may do.
# Never put the secret (service_role) key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your-publishable-or-anon-key
